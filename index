<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>اليعسوب...موطن الفن و الابتكار</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&display=swap" rel="stylesheet">
<style> :root {
  --font-thuluth: 'Amiri', 'Traditional Arabic', serif; /* خط ذو طابع كلاسيكي شبيه بالثلث للعناوين الرئيسية */
  --font-ruqaa: 'Aref Ruqaa', cursive;                /* خط الرقعة للعناوين الفرعية */
  --font-naskh: 'Noto Naskh Arabic', Tahoma, sans-serif; /* خط النسخ لباقي نصوص الموقع */
}

/* تطبيق خط النسخ على كامل الموقع بشكل افتراضي */
body {
  font-family: var(--font-naskh);
  background: var(--mist);
  color: var(--ink);
  line-height: 1.8;
  font-size: 16px;
}

/* العنوان الرئيسي للموقع (خط الثلث/الأميري الكلاسيكي) */
h1, .main-title, .site-title {
  font-family: var(--font-thuluth);
  font-weight: bold;
}

/* العناوين الفرعية (خط الرقعة) */
h2, h3, h4, h5, h6, .subtitle, .section-title {
  font-family: var(--font-ruqaa);
}
:root{
  --navy:#0A2540; --cobalt:#1456C8; --azure:#2F80ED; --sky:#8CC3F5; --ice:#EAF3FC; --mist:#F6FAFE;
  --ink:#10263F; --muted:#5B7089; --line:#D3E2F2;
  --font:"IBM Plex Sans Arabic",Tahoma,"Segoe UI",system-ui,sans-serif;
}
*{box-sizing:border-box;margin:0}
html{scroll-behavior:smooth}
body{font-family:var(--font);background:var(--mist);color:var(--ink);line-height:1.8;font-size:16px}
a{color:inherit;text-decoration:none}
button,input,select,textarea{font:inherit;color:inherit}
:focus-visible{outline:3px solid var(--azure);outline-offset:2px}
.wrap{max-width:1160px;margin:auto;padding:0 20px}

/* header */
header{position:sticky;top:0;z-index:20;background:rgba(255,255,255,.92);backdrop-filter:blur(8px);border-bottom:1px solid var(--line)}
.bar{display:flex;align-items:center;justify-content:space-between;height:68px;gap:16px}
.logo{display:flex;align-items:center;gap:10px;font-weight:700;font-size:19px;color:var(--navy)}
.caps{display:inline-block;width:34px;height:16px;border-radius:99px;background:linear-gradient(90deg,var(--navy) 50%,var(--sky) 50%);transform:rotate(-35deg);flex:none}
nav{display:flex;gap:26px;font-weight:500;color:var(--muted)}
nav a:hover{color:var(--cobalt)}
.btn{display:inline-flex;align-items:center;gap:8px;border:0;cursor:pointer;border-radius:99px;padding:10px 24px;font-weight:600;background:var(--cobalt);color:#fff;transition:background .2s}
.btn:hover{background:var(--navy)}
.btn.ghost{background:#fff;color:var(--cobalt);border:1.5px solid var(--cobalt)}
.btn.ghost:hover{background:var(--ice)}

/* hero */
.hero{background:linear-gradient(160deg,var(--navy) 0%,#0F3C78 60%,var(--cobalt) 100%);color:#fff;overflow:hidden;position:relative}
.hero .wrap{display:grid;grid-template-columns:1.15fr .85fr;gap:30px;align-items:center;padding-top:72px;padding-bottom:84px}
.hero h1{font-size:clamp(32px,5vw,54px);line-height:1.35;font-weight:700;max-width:14em}
.hero p{margin:18px 0 28px;color:#CFE4FA;max-width:34em;font-size:18px}
.search{display:flex;background:#fff;border-radius:99px;padding:6px;max-width:520px}
.search input{flex:1;border:0;background:none;padding:10px 20px;outline:none;color:var(--ink);min-width:0}
.search .btn{padding:10px 26px}
.stats{display:flex;gap:34px;margin-top:34px;color:#CFE4FA;font-size:15px}
.stats b{display:block;color:#fff;font-size:26px;line-height:1.3}
.art{position:relative;height:300px}
.art i{position:absolute;display:block;border-radius:99px}
.art .big{width:290px;height:120px;right:10%;top:90px;transform:rotate(-32deg);background:linear-gradient(90deg,#fff 50%,var(--sky) 50%);box-shadow:0 20px 50px rgba(0,0,0,.3);animation:settle 1.2s ease-out both}
.art .m{width:120px;height:48px;left:6%;top:30px;transform:rotate(18deg);background:linear-gradient(90deg,var(--azure) 50%,var(--ice) 50%);opacity:.9}
.art .s{width:70px;height:28px;left:20%;bottom:20px;transform:rotate(-12deg);background:var(--sky);opacity:.7}
.art .plus{width:54px;height:54px;right:2%;top:10px;border-radius:0;background:
  linear-gradient(var(--sky),var(--sky)) center/100% 16px no-repeat,
  linear-gradient(var(--sky),var(--sky)) center/16px 100% no-repeat;opacity:.5}
@keyframes settle{from{transform:rotate(-8deg) translateY(-30px);opacity:0}}

/* filters */
.tools{display:flex;flex-wrap:wrap;gap:10px;align-items:center;justify-content:space-between;margin:40px 0 24px}
.tools h2{font-size:26px;color:var(--navy)}
.pills{display:flex;flex-wrap:wrap;gap:8px}
.pill{border:1.5px solid var(--line);background:#fff;border-radius:99px;padding:6px 18px;cursor:pointer;font-weight:500;color:var(--muted);transition:.15s}
.pill:hover{border-color:var(--azure);color:var(--cobalt)}
.pill[aria-pressed=true]{background:linear-gradient(90deg,var(--navy) 50%,var(--cobalt) 50%);border-color:var(--navy);color:#fff}

/* cards */
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:22px;padding-bottom:70px}
.card{background:#fff;border:1px solid var(--line);border-radius:18px;overflow:hidden;cursor:pointer;text-align:start;display:flex;flex-direction:column;padding:0;transition:transform .2s,box-shadow .2s}
.card:hover{transform:translateY(-4px);box-shadow:0 14px 30px rgba(20,86,200,.14)}
.thumb{height:170px;position:relative;background:linear-gradient(135deg,var(--ice),var(--sky));display:grid;place-items:center}
.thumb img{width:100%;height:100%;object-fit:cover}
.thumb .caps{width:80px;height:34px}
.badge{position:absolute;top:12px;inset-inline-start:12px;background:var(--navy);color:#fff;border-radius:99px;font-size:13px;padding:2px 12px 2px 10px;display:flex;align-items:center;gap:6px}
.badge::before{content:"+";font-weight:700;color:var(--sky);font-size:17px;line-height:1}
.body{padding:18px 20px 20px;display:flex;flex-direction:column;gap:8px;flex:1}
.tag{align-self:flex-start;font-size:13px;font-weight:600;color:var(--cobalt);background:var(--ice);border-radius:99px;padding:0 12px}
.body h3{font-size:19px;line-height:1.5;color:var(--navy)}
.body p{color:var(--muted);font-size:15px;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}
.by{margin-top:auto;padding-top:12px;border-top:1px dashed var(--line);font-size:14px;color:var(--muted);display:flex;align-items:center;gap:10px}
.av{width:30px;height:30px;border-radius:50%;background:var(--cobalt);color:#fff;display:grid;place-items:center;font-weight:600;font-size:14px;flex:none}
.empty{grid-column:1/-1;text-align:center;padding:60px 0;color:var(--muted)}

/* dialogs */
dialog{border:0;border-radius:22px;padding:0;width:min(640px,92vw);max-height:90vh;overflow:auto;box-shadow:0 30px 80px rgba(10,37,64,.35)}
dialog::backdrop{background:rgba(10,37,64,.55)}
.dh{padding:28px 30px 8px;display:flex;justify-content:space-between;gap:12px;align-items:flex-start}
.dh h3{font-size:24px;color:var(--navy);line-height:1.5}
.x{border:0;background:var(--ice);width:36px;height:36px;border-radius:50%;cursor:pointer;font-size:20px;color:var(--cobalt);flex:none}
.db{padding:6px 30px 30px}
.db .thumb{border-radius:14px;margin:12px 0 18px;overflow:hidden}
.db p{white-space:pre-line}
.meta{display:flex;flex-wrap:wrap;gap:8px;margin:12px 0 18px}
form label{display:block;font-weight:600;font-size:14px;margin:14px 0 4px;color:var(--navy)}
form input,form select,form textarea{width:100%;border:1.5px solid var(--line);border-radius:12px;padding:10px 14px;background:var(--mist)}
form input:focus,form select:focus,form textarea:focus{outline:none;border-color:var(--azure);background:#fff}
form .btn{margin-top:20px;width:100%;justify-content:center}
.note{font-size:14px;color:var(--muted);margin-top:12px}
.toast{position:fixed;bottom:24px;left:50%;transform:translateX(-50%);background:var(--navy);color:#fff;padding:12px 26px;border-radius:99px;z-index:50;opacity:0;pointer-events:none;transition:opacity .25s}
.toast.on{opacity:1}

footer{background:var(--navy);color:#9DB8D6;padding:30px 0;text-align:center;font-size:15px}
footer .caps{margin-inline:6px;vertical-align:middle}

@media(max-width:820px){
  nav{display:none}
  .hero .wrap{grid-template-columns:1fr;padding-top:48px;padding-bottom:56px}
  .art{display:none}
}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
</style>
</head>
<body>

<header>
  <div class="wrap bar">
    <a href="#top" class="logo"><span class="caps"></span>إبداع الطلبة</a>
    <nav><a href="#projects">المشاريع</a><a href="#about">عن المنصة</a></nav>
    <button class="btn" id="openSubmit">أضيفي مشروعك</button>
  </div>
</header>

<section class="hero" id="top">
  <div class="wrap">
    <div>
      <h1>مشاريع طلابية بروح علمية، في مكان واحد</h1>
      <p>تصفّحي أبحاث وتجارب وتصاميم الطلبة، وشاركي مشروعك ليراه الجميع.</p>
      <form class="search" id="searchForm" role="search">
        <input id="q" type="search" placeholder="ابحثي باسم المشروع أو الطالب" aria-label="بحث">
        <button class="btn" type="submit">بحث</button>
      </form>
      <div class="stats">
        <div><b id="sP">0</b>مشروع</div>
        <div><b id="sA">0</b>طالب</div>
        <div><b id="sC">0</b>مجال</div>
      </div>
    </div>
    <div class="art" aria-hidden="true"><i class="big"></i><i class="m"></i><i class="s"></i><i class="plus"></i></div>
  </div>
</section>

<main class="wrap" id="projects">
  <div class="tools">
    <h2>أحدث المشاريع</h2>
    <div class="pills" id="pills" role="group" aria-label="تصفية حسب المجال"></div>
  </div>
  <div class="grid" id="grid"></div>
</main>

<section class="wrap" id="about" style="padding-bottom:60px">
  <div style="background:var(--ice);border-radius:22px;padding:34px;display:flex;gap:24px;align-items:center;flex-wrap:wrap;justify-content:space-between">
    <div style="max-width:620px">
      <h2 style="color:var(--navy);font-size:24px">لكل مشروع مساحة يُرى فيها</h2>
      <p style="color:var(--muted)">ترسلين مشروعك مع وصف وصورة ورابط، وتتم مراجعته قبل ظهوره في المعرض.</p>
    </div>
    <button class="btn ghost" id="openSubmit2">أضيفي مشروعك</button>
  </div>
</section>

<footer><span class="caps"></span> منصة إبداعات الطلبة © <span id="yr"></span></footer>

<dialog id="viewD">
  <div class="dh"><h3 id="vT"></h3><button class="x" data-close aria-label="إغلاق">×</button></div>
  <div class="db" id="vB"></div>
</dialog>

<dialog id="subD">
  <div class="dh"><h3>أضيفي مشروعك</h3><button class="x" data-close aria-label="إغلاق">×</button></div>
  <form class="db" id="subF">
    <label for="f_title">اسم المشروع</label><input id="f_title" name="title" required maxlength="120">
    <label for="f_cat">المجال</label><select id="f_cat" name="category" required></select>
    <label for="f_desc">وصف المشروع</label><textarea id="f_desc" name="description" rows="4" required maxlength="1500"></textarea>
    <label for="f_author">اسم الطالب</label><input id="f_author" name="author_name" required maxlength="80">
    <label for="f_dept">القسم أو الكلية</label><input id="f_dept" name="department" maxlength="80">
    <label for="f_img">رابط صورة المشروع</label><input id="f_img" name="image_url" type="url" placeholder="https://">
    <label for="f_link">رابط المشروع</label><input id="f_link" name="link_url" type="url" placeholder="https://">
    <button class="btn" type="submit">إرسال للمراجعة</button>
    <p class="note">يظهر المشروع في المعرض بعد موافقة المشرف.</p>
  </form>
</dialog>

<div class="toast" id="toast" role="status"></div>

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.45.4/dist/umd/supabase.min.js"></script>
<script>
/* ===== 1) ضعي بيانات مشروعك في Supabase هنا ===== */
const SUPABASE_URL = "";        // مثال: https://xxxx.supabase.co
const SUPABASE_ANON_KEY = "";   // المفتاح العام anon فقط
/* ================================================ */

const CATS = ["أبحاث علمية","تجارب معملية","تقنية وبرمجة","تصميم وفنون","مشاريع تخرج"];
const DEMO = [
  {id:1,title:"دليل التفاعلات الدوائية التفاعلي",description:"تطبيق ويب يساعد الطلبة على التحقق من التداخلات بين الأدوية الشائعة مع شرح مبسّط لكل حالة.",category:"تقنية وبرمجة",author_name:"سارة محمود",department:"كلية الصيدلة",featured:true},
  {id:2,title:"استخلاص مضادات الأكسدة من قشور الرمان",description:"بحث معملي يقارن طرق الاستخلاص ويقيس فاعلية المستخلص في تثبيط الجذور الحرة.",category:"تجارب معملية",author_name:"أحمد علي",department:"قسم الكيمياء"},
  {id:3,title:"هوية بصرية لحملة التوعية بالمضادات الحيوية",description:"مجموعة ملصقات وإنفوجرافيك لتوعية المجتمع بالاستخدام الآمن للمضادات الحيوية.",category:"تصميم وفنون",author_name:"مريم خالد",department:"كلية الفنون التطبيقية"},
  {id:4,title:"نظام تذكير بمواعيد الدواء",description:"مشروع تخرج يربط تطبيق الهاتف بعلبة دواء ذكية ترسل تنبيهات لكبار السن ومرافقيهم.",category:"مشاريع تخرج",author_name:"يوسف حسن",department:"كلية الهندسة",featured:true},
  {id:5,title:"تأثير النباتات الطبية على نمو البكتيريا",description:"دراسة ميدانية على خمسة مستخلصات نباتية مع تحليل إحصائي للنتائج.",category:"أبحاث علمية",author_name:"نور إبراهيم",department:"كلية العلوم"},
  {id:6,title:"موقع تفاعلي لتعليم الجهاز المناعي",description:"رسوم متحركة وأسئلة قصيرة تشرح كيف يعمل الجهاز المناعي لطلبة المرحلة الثانوية.",category:"تقنية وبرمجة",author_name:"ليلى سامي",department:"كلية الحاسبات"}
];

const sb = (SUPABASE_URL && SUPABASE_ANON_KEY && window.supabase) ? window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY) : null;
const $ = id => document.getElementById(id);
const esc = s => String(s ?? "").replace(/[&<>"']/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
const safeUrl = u => /^https?:\/\//i.test(u || "") ? u : "";
let projects = [], cat = "الكل", term = "";

function toast(m){const t=$("toast");t.textContent=m;t.classList.add("on");setTimeout(()=>t.classList.remove("on"),3200)}

async function load(){
  if(!sb){projects = DEMO; return render();}
  const {data,error} = await sb.from("projects").select("*").eq("status","approved")
    .order("featured",{ascending:false}).order("created_at",{ascending:false});
  if(error){toast("تعذّر تحميل المشاريع، حاولي مرة أخرى");projects=[]}else projects=data;
  render();
}

function thumb(p){
  const u = safeUrl(p.image_url);
  return `<div class="thumb">${u?`<img src="${esc(u)}" alt="${esc(p.title)}" loading="lazy">`:'<span class="caps"></span>'}${p.featured?'<span class="badge">مميز</span>':''}</div>`;
}

function render(){
  $("sP").textContent = projects.length;
  $("sA").textContent = new Set(projects.map(p=>p.author_name)).size;
  $("sC").textContent = new Set(projects.map(p=>p.category)).size;
  const list = projects.filter(p => (cat==="الكل"||p.category===cat) &&
    (!term || [p.title,p.author_name,p.description].join(" ").includes(term)));
  $("grid").innerHTML = list.length ? list.map(p=>`
    <button class="card" data-id="${esc(p.id)}">
      ${thumb(p)}
      <div class="body">
        <span class="tag">${esc(p.category)}</span>
        <h3>${esc(p.title)}</h3>
        <p>${esc(p.description)}</p>
        <div class="by"><span class="av">${esc((p.author_name||"؟").trim().charAt(0))}</span><span>${esc(p.author_name)}${p.department?" · "+esc(p.department):""}</span></div>
      </div>
    </button>`).join("") : '<div class="empty">لا توجد مشاريع مطابقة. جرّبي مجالاً آخر أو أضيفي مشروعك.</div>';
}

function pills(){
  $("pills").innerHTML = ["الكل",...CATS].map(c=>`<button class="pill" aria-pressed="${c===cat}" data-c="${c}">${c}</button>`).join("");
  $("f_cat").innerHTML = CATS.map(c=>`<option>${c}</option>`).join("");
}

$("pills").addEventListener("click",e=>{const b=e.target.closest(".pill");if(!b)return;cat=b.dataset.c;pills();render()});
$("searchForm").addEventListener("submit",e=>{e.preventDefault();term=$("q").value.trim();render();$("projects").scrollIntoView()});
$("grid").addEventListener("click",e=>{
  const c=e.target.closest(".card");if(!c)return;
  const p=projects.find(x=>String(x.id)===c.dataset.id);if(!p)return;
  const l=safeUrl(p.link_url);
  $("vT").textContent=p.title;
  $("vB").innerHTML=`${thumb(p)}<div class="meta"><span class="tag">${esc(p.category)}</span></div>
    <p>${esc(p.description)}</p>
    <div class="by" style="margin-top:20px"><span class="av">${esc((p.author_name||"؟").trim().charAt(0))}</span><span>${esc(p.author_name)}${p.department?" · "+esc(p.department):""}</span></div>
    ${l?`<a class="btn" style="margin-top:20px" href="${esc(l)}" target="_blank" rel="noopener noreferrer">افتحي المشروع</a>`:""}`;
  $("viewD").showModal();
});

["openSubmit","openSubmit2"].forEach(id=>$(id).addEventListener("click",()=>$("subD").showModal()));
document.querySelectorAll("[data-close]").forEach(b=>b.addEventListener("click",()=>b.closest("dialog").close()));
document.querySelectorAll("dialog").forEach(d=>d.addEventListener("click",e=>{if(e.target===d)d.close()}));

$("subF").addEventListener("submit",async e=>{
  e.preventDefault();
  if(!sb){toast("اربطي Supabase أولاً لتفعيل الإرسال");return}
  const row = Object.fromEntries(new FormData(e.target));
  row.status = "pending";
  const {error} = await sb.from("projects").insert(row);
  if(error){toast("لم يتم الإرسال، راجعي البيانات وحاولي مجدداً");return}
  e.target.reset();$("subD").close();toast("تم إرسال مشروعك وسيظهر بعد المراجعة");
});

$("yr").textContent = new Date().getFullYear();
pills();load();
</script>
</body>
</html>
